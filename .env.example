# Local development only. Never commit real secrets.
APP_ENV=development
DATABASE_URL=sqlite:///./fossil_science_bowl_local.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-password
APP_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Local folder for quiz content. On Render, use GITHUB_REPOSITORY instead.
QUIZ_CONTENT_DIR=quiz-repository-template/quizzes

# GitHub quiz repository (server-side access)
# GITHUB_REPOSITORY=YOUR-USERNAME/fossil-ridge-science-bowl-quizzes
GITHUB_BRANCH=main
GITHUB_QUIZZES_PATH=quizzes
GITHUB_TOKEN=
QUIZ_CACHE_SECONDS=120
AUDIO_CACHE_MAX_BYTES=94371840

# B2 database snapshots (optional but strongly recommended)
B2_ENDPOINT=
B2_REGION=us-west-004
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PREFIX=fossil-science-bowl
B2_BACKUP_INITIAL_DELAY_SECONDS=90
B2_BACKUP_QUIET_PERIOD_SECONDS=300

BUZZ_AUDIO_STOP_MIN_MS=200
BUZZ_AUDIO_STOP_MAX_MS=500
BUZZ_END_WINDOW_MS=500
